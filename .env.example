# Optional local database override (default: ./data/salespilot.db)
# SALESPILOT_DB_PATH=./data/salespilot.db

# Optional local Whisper.cpp speech-to-text.
# Build whisper.cpp and download a compatible model file before enabling these.
# WHISPER_CPP_BIN=/absolute/path/to/whisper.cpp/build/bin/whisper-cli
# WHISPER_MODEL_PATH=/absolute/path/to/ggml-small.bin

# Optional local OpenAI-compatible model endpoint (e.g. LM Studio local server).
# No hosted API is used by default. This endpoint must point to a model running on your machine.
# SALESPILOT_LOCAL_LLM_URL=http://127.0.0.1:1234/v1/chat/completions
# SALESPILOT_LOCAL_LLM_MODEL=local-model
# SALESPILOT_LOCAL_LLM_API_KEY=
