# Optional server port (default used by run.sh and __main__.py: 8008)
# PORT=8008

# Optional local database override (default: ./data/salespilot.db)
# SALESPILOT_DB_PATH=./data/salespilot.db

# Optional local Whisper.cpp speech-to-text.
# Install whisper.cpp + ffmpeg and download a compatible GGML model before enabling.
# WHISPER_CPP_BIN=/opt/homebrew/bin/whisper-cli
# WHISPER_MODEL_PATH=./models/ggml-base.bin

# Optional local OpenAI-compatible model endpoint (e.g. Ollama or LM Studio).
# No hosted API is used by default. This endpoint must point to a model running on your machine.
# SALESPILOT_LOCAL_LLM_URL=http://127.0.0.1:11434/v1/chat/completions
# SALESPILOT_LOCAL_LLM_MODEL=qcod:latest
# SALESPILOT_LOCAL_LLM_API_KEY=
